<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
         Declared optional. Without this, Play treats the CAMERA permission as
         an implicit hardware requirement and hides the app from devices with
         no camera — including most tablets — even though scanning from the
         gallery works perfectly well there.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
         The drag-to-reorder haptics call Vibrator.vibrate, which
         throws SecurityException without this. It is a normal
         permission, granted at install with no prompt.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
         No broad storage permission is declared, and none is needed. Images
         arrive through the photo picker, which grants read access to the one
         URI it returns; saved scans and PDFs go out through MediaStore, which
         needs no permission on Android 10 and up. MANAGE_EXTERNAL_STORAGE used
         to be declared here and was never requested in code — dead weight that
         Play would have rejected on its own.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocKeep"
        tools:targetApi="31">
        
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        
        <activity
            android:name=".DocumentDetailActivity"
            android:exported="false" />
            
        <activity
            android:name=".ImageViewerActivity"
            android:exported="false" />
            
        <activity
            android:name=".FamilyFriendsActivity"
            android:exported="false" />
            
        <activity
            android:name=".PersonDocumentsActivity"
            android:exported="false" />
            
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ScanEditorActivity"
            android:exported="false" />
            
        <!-- FileProvider for sharing files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>