<?xml version="1.0" encoding="utf-8"?>
<!--
    Ledger widget styles.

    Material's defaults are built on radius and elevation, which this design
    has none of, so each style below zeroes those out rather than inheriting
    them.
-->
<resources>

    <!-- Quick-start and "file under" chips: 2px rule, square, no fill. -->
    <style name="Widget.Ledger.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">0dp</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipStrokeColor">@color/ledger_rule</item>
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="rippleColor">@color/ledger_rule</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="android:textColor">@color/ledger_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.Chip</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="TextAppearance.Ledger.Chip" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="fontFamily">@font/archivo_semibold</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Bottom sheets are flat panels with a 2px top rule, not rounded cards. -->
    <style name="Widget.Ledger.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@drawable/ledger_sheet_background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ledger.None</item>
    </style>

    <style name="ShapeAppearance.Ledger.None" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Theme.Ledger.BottomSheetDialog" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Ledger.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/ledger_bg</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <!-- Square toggle for the drawer's biometric row. -->
    <style name="Widget.Ledger.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/ledger_switch_thumb</item>
        <item name="android:track">@drawable/ledger_switch_track</item>
    </style>


    <!--
        Kept for the screens that still reference them from XML. These lived
        only in values-night/, so in light mode they resolved to nothing and
        threw Resources.NotFoundException at inflation time; defining them in
        the default config fixes that. Restyled flat to match the design.
    -->
    <style name="Widget.DocKeep.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Ledger.None</item>
        <item name="backgroundTint">@color/ledger_accent</item>
        <item name="tint">@color/ledger_on_accent</item>
    </style>

    <style name="Widget.DocKeep.PortfolioButton" parent="Widget.Ledger.Button">
        <item name="android:textAllCaps">true</item>
    </style>


    <!-- ── Scan editor ────────────────────────────────────────────────── -->

    <!-- One tool cell in the editor's geometry row. -->
    <style name="Widget.Ledger.EditorTool" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/ledger_cell</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Ledger.EditorToolLabel" parent="TextAppearance.Ledger.Kicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAppearance">@style/TextAppearance.Ledger.Kicker</item>
    </style>

    <!-- Flat slider: a 2px rule for the track, a square accent thumb. -->
    <style name="Widget.Ledger.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/ledger_seekbar_track</item>
        <item name="android:thumb">@drawable/ledger_seekbar_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>


    <!--
        Quick-start box. What the design actually draws: a 2px rule, no fill,
        tracked micro-caps. A plain TextView, so the label always renders.
    -->
    <style name="Widget.Ledger.QuickChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ledger_chip_outline</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ledger_text</item>
    </style>


    <!-- Viewer tool cell. Same shape as the editor's, drawn on ink. -->
    <style name="Widget.Ledger.ViewerTool" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
    </style>

    <style name="Widget.Ledger.ViewerToolLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:fontFamily">@font/archivo_bold</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#F8F4F4</item>
    </style>

</resources>
