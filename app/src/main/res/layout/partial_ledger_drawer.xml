<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings drawer.

    Navigation moved to the bottom bar, so this panel now holds settings only.
    It is a plain panel with a 2px rule down its leading edge — no scrim of its
    own, no elevation, no rounded corner.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebarLayout"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/ledger_bg"
    android:orientation="horizontal"
    android:visibility="gone">

    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@color/ledger_rule_strong" />

    <LinearLayout
        android:id="@+id/drawerColumn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ledger_settings"
                    android:textAppearance="@style/TextAppearance.Ledger.Meta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Ledger.Title"
                    android:textSize="21sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/drawerCloseButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ledger_box_outline"
                android:contentDescription="@string/ledger_close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/ledger_text" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule_strong" />

        <!-- Appearance -->
        <LinearLayout
            android:id="@+id/themeOption"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/ledger_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/themeIcon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_theme_light"
                app:tint="@color/ledger_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/ledger_appearance"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/themeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ledger_theme_light"
                android:textAppearance="@style/TextAppearance.Ledger.Meta"
                android:textColor="@color/ledger_accent" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule" />

        <!-- Export -->
        <LinearLayout
            android:id="@+id/exportOption"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/ledger_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@color/ledger_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/ledger_export_all"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/exportSizeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Ledger.Meta" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule" />

        <!-- Import -->
        <LinearLayout
            android:id="@+id/importOption"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/ledger_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/import_icon"
                app:tint="@color/ledger_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/ledger_import_documents"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule" />

        <!-- Lock with biometrics -->
        <LinearLayout
            android:id="@+id/lockOption"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/ledger_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield"
                app:tint="@color/ledger_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/ledger_lock"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/lockSwitch"
                style="@style/Widget.Ledger.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:duplicateParentState="true"
                android:focusable="false" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule" />

        <!-- Feedback. Also carries the version, which otherwise appears
             nowhere now that the developer page is gone. -->
        <LinearLayout
            android:id="@+id/feedbackOption"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/ledger_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                app:tint="@color/ledger_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/ledger_feedback"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Ledger.Meta" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/ledger_rule_strong" />

        <!-- Current user -->
        <LinearLayout
            android:id="@+id/userNameDisplayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ledger_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <!-- Letter tile by default; the photo covers it when one is set. -->
            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp">

                <TextView
                    android:id="@+id/userNameLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ledger_tile"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Ledger.Tile"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/userNameIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/userNameDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
