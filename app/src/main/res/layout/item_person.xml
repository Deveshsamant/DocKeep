<?xml version="1.0" encoding="utf-8"?>
<!--
    Person cell.

    Same construction as the document cell, with one addition: a row of small
    squares showing the letter-tile colours of the documents filed under this
    person, then "+N" for the rest. It gives each shelf a recognisable
    signature without a thumbnail.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_cell"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/personInitialTextView"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/ledger_tile"
        android:gravity="center"
        android:text="@string/document_initial_placeholder"
        android:textAppearance="@style/TextAppearance.Ledger.Tile" />

    <TextView
        android:id="@+id/personNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Person"
        android:textAppearance="@style/TextAppearance.Ledger.CellTitle"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/personMetaTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Ledger.Meta" />

    <!-- Colour signature of the documents on this shelf. -->
    <LinearLayout
        android:id="@+id/personSwatchRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/swatch1"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:background="@drawable/ledger_tile" />

        <View
            android:id="@+id/swatch2"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/ledger_tile" />

        <View
            android:id="@+id/swatch3"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/ledger_tile" />

        <View
            android:id="@+id/swatch4"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/ledger_tile" />

        <TextView
            android:id="@+id/swatchOverflow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="@style/TextAppearance.Ledger.Meta"
            android:textSize="9.5sp" />

    </LinearLayout>

</LinearLayout>
