<?xml version="1.0" encoding="utf-8"?>
<!--
    One selectable block in the PDF picker.

    The square check is the same marker the grid uses for multi-select, so
    "chosen" looks the same everywhere in the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blockRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/blockCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/ledger_check_box" />

    <TextView
        android:id="@+id/blockOrdinal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:letterSpacing="0.12"
        android:textAppearance="@style/TextAppearance.Ledger.Meta"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/blockLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Ledger.RowTitle"
        android:textAllCaps="false"
        android:textSize="14sp" />

</LinearLayout>
