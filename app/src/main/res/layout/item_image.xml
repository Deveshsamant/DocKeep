<?xml version="1.0" encoding="utf-8"?>
<!--
    Scan cell.

    The design replaces the three translucent buttons that used to float over
    every thumbnail with a caption bar: the scan's index on the left and one
    overflow on the right. The thumbnail is left unobstructed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_cell"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/ledger_neutral_200"
        android:contentDescription="@string/ledger_scan_thumbnail"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_document_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/captionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ledger.Meta"
            android:textColor="@color/ledger_neutral_700"
            android:textSize="9.5sp" />

        <ImageButton
            android:id="@+id/overflowButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

</LinearLayout>
