<?xml version="1.0" encoding="utf-8"?>
<!--
    Add person sheet.

    One field, because that is all a shelf needs to exist. The name drives the
    letter tile and its colour, so nothing else is asked for up front.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_sheet_background"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingTop="18dp"
      android:paddingEnd="20dp"
      android:paddingBottom="20dp">

    <TextView
        android:id="@+id/sheetKicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ledger_add_person"
        android:textAppearance="@style/TextAppearance.Ledger.KickerAccent" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ledger_sheet_who"
        android:textAppearance="@style/TextAppearance.Ledger.Title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ledger_input">

        <EditText
            android:id="@+id/personNameEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/person_name_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ledger.Input" />

    </FrameLayout>

  </LinearLayout>

    <!-- ── Add ────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/sheetAddPerson"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/ledger_action_bar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_add"
            app:tint="@color/ledger_on_accent" />

        <TextView
            android:id="@+id/sheetAddPersonLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ledger_add_person"
            android:textAppearance="@style/TextAppearance.Ledger.ActionBar" />

    </LinearLayout>

</LinearLayout>
