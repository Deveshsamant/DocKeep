<?xml version="1.0" encoding="utf-8"?>
<!--
    Share sheet. The same two shapes as download — one document, or the
    scans themselves — handed to the Android share sheet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_sheet_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheetKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                android:textAppearance="@style/TextAppearance.Ledger.KickerAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/share_all"
                android:textAppearance="@style/TextAppearance.Ledger.Title" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/sheetClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ledger_box_outline"
            android:contentDescription="@string/ledger_close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/ledger_text" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule_strong" />

    <LinearLayout
        android:id="@+id/sharePdfOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pdf"
            app:tint="@color/ledger_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ledger_option_share_pdf"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ledger_option_share_pdf_sub"
                android:textAppearance="@style/TextAppearance.Ledger.RowSubtitle" />

        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule" />

    <LinearLayout
        android:id="@+id/sharePdfNotesOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_note"
            app:tint="@color/ledger_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ledger_share_pdf_notes"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

            <TextView
                android:id="@+id/sharePdfNotesSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ledger_share_pdf_notes_sub"
                android:textAppearance="@style/TextAppearance.Ledger.RowSubtitle" />

        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

    <View
        android:id="@+id/sharePdfNotesRule"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule" />

    <LinearLayout
        android:id="@+id/shareImagesOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_image"
            app:tint="@color/ledger_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ledger_option_share_images"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ledger_option_share_images_sub"
                android:textAppearance="@style/TextAppearance.Ledger.RowSubtitle" />

        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule" />

    <TextView
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:letterSpacing="0.14"
        android:paddingStart="20dp"
        android:text="@string/cancel"
        android:textAppearance="@style/TextAppearance.Ledger.ActionBar"
        android:textColor="@color/ledger_neutral_700" />

</LinearLayout>
