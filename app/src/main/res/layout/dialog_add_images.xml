<?xml version="1.0" encoding="utf-8"?>
<!--
    Add scans sheet. Two ways in — the camera or what is already in the
    gallery — given equal weight as two rows rather than as a button pair.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_sheet_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheetKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_images"
                android:textAppearance="@style/TextAppearance.Ledger.KickerAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ledger_sheet_add_scans"
                android:textAppearance="@style/TextAppearance.Ledger.Title" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/sheetClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ledger_box_outline"
            android:contentDescription="@string/ledger_close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/ledger_text" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule_strong" />

    <LinearLayout
        android:id="@+id/cameraOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_camera"
            app:tint="@color/ledger_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/take_photo"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/capture_a_new_photo_with_your_camera"
                android:textAppearance="@style/TextAppearance.Ledger.RowSubtitle" />

        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule" />

    <LinearLayout
        android:id="@+id/galleryOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_gallery"
            app:tint="@color/ledger_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_from_gallery"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/select_multiple_images_from_your_device"
                android:textAppearance="@style/TextAppearance.Ledger.RowSubtitle" />

        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule" />

    <LinearLayout
        android:id="@+id/noteOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_note"
            app:tint="@color/ledger_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ledger_note_title"
                android:textAppearance="@style/TextAppearance.Ledger.RowTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ledger_note_sub"
                android:textAppearance="@style/TextAppearance.Ledger.RowSubtitle" />

        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/ledger_rule" />


    <TextView
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/ledger_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:letterSpacing="0.14"
        android:paddingStart="20dp"
        android:text="@string/cancel"
        android:textAppearance="@style/TextAppearance.Ledger.ActionBar"
        android:textColor="@color/ledger_neutral_700" />

</LinearLayout>
