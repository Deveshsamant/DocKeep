<?xml version="1.0" encoding="utf-8"?>
<!--
    First run.

    One step, one promise, one field. The vault illustration carries the whole
    pitch — papers shut inside something that never leaves the phone — so the
    copy underneath stays to three short lines and the only control above the
    call to action is the name field.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ledger_bg"
    android:orientation="vertical"
    tools:context="com.dockeep.app.OnboardingActivity">

    <!-- ── Step indicator ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="@string/ledger_step_1_of_1"
            android:textAppearance="@style/TextAppearance.Ledger.Meta" />

        <!-- Track with the accent showing the single step complete -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="9dp"
            android:background="@color/ledger_rule">

            <View
                android:layout_width="64dp"
                android:layout_height="2dp"
                android:background="@color/ledger_accent" />

        </FrameLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Vault ──────────────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <com.dockeep.app.ui.VaultView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/ledger_rule_strong" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="-0.035"
                    android:lineSpacingMultiplier="0.94"
                    android:text="@string/ledger_onboarding_headline"
                    android:textAppearance="@style/TextAppearance.Ledger.Display"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.6"
                    android:text="@string/ledger_onboarding_body"
                    android:textAppearance="@style/TextAppearance.Ledger.Body"
                    android:textColor="@color/ledger_neutral_800" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="9dp"
                    android:letterSpacing="0.16"
                    android:text="@string/ledger_call_you"
                    android:textAppearance="@style/TextAppearance.Ledger.Meta"
                    android:textColor="@color/ledger_neutral_700" />

                <FrameLayout
                    android:id="@+id/userNameInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/ledger_input">

                    <EditText
                        android:id="@+id/userNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/ledger_your_name"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Ledger.Input" />

                </FrameLayout>

                <!-- ── Permission note ────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/ledger_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="@string/ledger_permission_note"
                        android:textAppearance="@style/TextAppearance.Ledger.Meta" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ── Call to action ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/continueButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/ledger_action_bar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="@string/ledger_open_vault"
            android:textAppearance="@style/TextAppearance.Ledger.ActionBar" />

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ledger_on_accent" />

    </LinearLayout>

</LinearLayout>
