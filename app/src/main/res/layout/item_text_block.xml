<?xml version="1.0" encoding="utf-8"?>
<!--
    Note cell.

    Sits in the same grid as the scans and reads as a page rather than a
    photo: a tracked NOTE kicker, a 2px rule, then the body. Same footprint as
    a scan cell so the grid stays even.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ledger_cell"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/ledger_surface"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/ledger_note"
            android:textAppearance="@style/TextAppearance.Ledger.Kicker"
            android:textColor="@color/ledger_accent"
            android:textSize="9.5sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="@color/ledger_rule_strong" />

        <TextView
            android:id="@+id/textBlockBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.4"
            android:textAppearance="@style/TextAppearance.Ledger.Body"
            android:textColor="@color/ledger_text"
            android:textSize="12.5sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/captionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Ledger.Meta"
            android:textColor="@color/ledger_neutral_700"
            android:textSize="9.5sp" />

        <ImageButton
            android:id="@+id/overflowButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ledger_neutral_500" />

    </LinearLayout>

</LinearLayout>
