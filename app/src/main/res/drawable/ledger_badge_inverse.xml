<?xml version="1.0" encoding="utf-8"?>
<!-- The camera badge on the avatar: ink square, accent while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_inverse_bg" />
        </shape>
    </item>
</selector>
