<?xml version="1.0" encoding="utf-8"?>
<!--
    Square checkbox. Filled accent when chosen, a 2px rule when not — the same
    two states the grid's selection marker uses.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ledger_accent" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_check"
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/ledger_rule" />
        </shape>
    </item>
</selector>
