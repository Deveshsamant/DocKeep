<?xml version="1.0" encoding="utf-8"?>
<!--
    Square outlined button on ink. Used by the image viewer, which stays dark
    on both themes, so the rule is a fixed 28% white rather than a token.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#47F3F2F2">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#F8F4F4" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#33F8F4F4" />
                    <stroke android:width="2dp" android:color="#F8F4F4" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="#8AF3F2F2" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
