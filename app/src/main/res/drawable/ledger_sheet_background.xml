<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-sheet panel: flat fill closed by a 2px rule along its top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_bg" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_rule_strong" />
        </shape>
    </item>
</layer-list>
