<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: 2px rule all round, surface fill, square corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_surface" />
            <stroke android:width="2dp" android:color="@color/ledger_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_surface" />
            <stroke android:width="2dp" android:color="@color/ledger_text" />
        </shape>
    </item>
</selector>
