<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorPrimary">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <!-- Shadow layers for 3D effect -->
                    <item android:top="4dp" android:left="4dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/shadow_color_1" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                    <item android:top="3dp" android:left="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/shadow_color_2" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                    <item android:top="2dp" android:left="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/shadow_color_3" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                    <!-- Card background with subtle gradient and pressed state -->
                    <item android:bottom="1dp" android:right="1dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="?attr/colorSurface"
                                android:endColor="?attr/colorSurfaceVariant"
                                android:angle="270"
                                android:type="linear" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <!-- Shadow layers for 3D effect -->
                    <item android:top="4dp" android:left="4dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/shadow_color_1" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                    <item android:top="3dp" android:left="3dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/shadow_color_2" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                    <item android:top="2dp" android:left="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/shadow_color_3" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                    <!-- Card background with subtle gradient -->
                    <item android:bottom="2dp" android:right="2dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="?attr/colorSurface"
                                android:endColor="?attr/colorSurfaceVariant"
                                android:angle="270"
                                android:type="linear" />
                            <corners android:radius="@dimen/card_corner_radius" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>