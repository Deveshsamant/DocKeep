<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-start / filter chip: 2px rule, no fill, turns accent on press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/ledger_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_inverse_bg" />
            <stroke android:width="2dp" android:color="@color/ledger_inverse_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/ledger_rule" />
        </shape>
    </item>
</selector>
