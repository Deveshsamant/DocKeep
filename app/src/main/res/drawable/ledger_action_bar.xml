<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed accent bar (NEW DOCUMENT, ADD SCANS, CREATE ...). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ledger_accent_600" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ledger_accent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
