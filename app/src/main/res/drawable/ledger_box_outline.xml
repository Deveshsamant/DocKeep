<?xml version="1.0" encoding="utf-8"?>
<!-- Square 2px-outlined icon button. No radius: the Ledger grid has none. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ledger_rule">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/ledger_text" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ledger_text" />
                    <stroke android:width="2dp" android:color="@color/ledger_text" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/ledger_text" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
