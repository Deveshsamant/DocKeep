<?xml version="1.0" encoding="utf-8"?>
<!--
    Archivo (SIL Open Font License 1.1) — the Ledger design's only typeface.

    Static instances cut from the variable font at wdth=100 so the heavy
    display weights render correctly all the way down to minSdk 21, where
    variable-font axes are not honoured.

    Both the `android:` and `app:` attributes are declared on every entry:
    the framework reads the former on API 26+, AppCompat's compat loader the
    latter below that.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/archivo_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/archivo_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/archivo_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/archivo_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/archivo_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/archivo_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/archivo_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/archivo_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/archivo_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/archivo_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />

    <font
        android:font="@font/archivo_black"
        android:fontStyle="normal"
        android:fontWeight="900"
        app:font="@font/archivo_black"
        app:fontStyle="normal"
        app:fontWeight="900" />
</font-family>
